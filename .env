# NAC site settings — the one place to change owner, contact and ad details.
# These values are public (they appear on the About, Privacy and Terms pages).

VITE_OWNER_NAME=Shelby
VITE_CONTACT_EMAIL=CONTACT_EMAIL_NOT_SET
VITE_SITE_URL=https://nac-flame.vercel.app
VITE_LAST_UPDATED=26 September 2026

# Google AdSense. Fill in VITE_ADSENSE_CLIENT (looks like ca-pub-1234567890123456)
# when you apply: it adds Google's verification script and ads.txt. Leave
# VITE_ADSENSE_SLOT empty until you're approved and have created an ad unit;
# the ad box only appears once both are set.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
